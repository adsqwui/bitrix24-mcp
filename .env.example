# Incoming webhook: Bitrix24 -> Developer resources -> Other -> Incoming webhook
# The portal and the user are taken from this URL.
B24_WEBHOOK_URL=https://your-portal.bitrix24.ru/rest/1/REPLACE_WITH_SECRET/
MCP_READ_ONLY=true
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_BEARER_TOKEN=
MCP_ALLOWED_ROOTS=/absolute/safe/path
MCP_AUDIT_LOG=var/audit.jsonl
MCP_MAX_FILE_BYTES=10485760
B24_DISK_FOLDER_ID=
